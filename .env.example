# File: .env.example
# Purpose: Template for environment variables. Copy to .env.local for local
# development and set the same keys in your hosting provider for production.

# --- Required for scans -----------------------------------------------------
# Solana Tracker Data API key (https://www.solanatracker.io/data-api).
# Without it the site runs, and report pages show a "scanner is not connected"
# notice instead of results.
SOLANA_TRACKER_API_KEY=

# --- Recommended ------------------------------------------------------------
# Public origin of the deployed site, no trailing slash. Used for share links
# and social card URLs. On Vercel the production domain is used automatically
# when this is unset.
NEXT_PUBLIC_SITE_URL=

# --- Optional: token and community links -------------------------------------
# Each element is hidden on the site while its variable is empty.
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_BUY_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# --- Optional: tuning ---------------------------------------------------------
# Scans allowed per client IP per minute (default 12).
SCAN_RATE_LIMIT_PER_MINUTE=
# Override the data provider origin (default https://data.solanatracker.io).
SOLANA_TRACKER_BASE_URL=
